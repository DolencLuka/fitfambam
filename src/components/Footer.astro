---
import Wordmark from "./Wordmark.astro";
import { site } from "../lib/site";
import { copy, homeHref, localeFromPath, nav, siblingPath, type Locale } from "../lib/i18n";
import { getCollection } from "astro:content";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);
const home = homeHref(locale);
const visit = nav[locale].filter((item) => item.href !== home);
const other = siblingPath(Astro.url.pathname);

const posts = (await getCollection("journal"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <Wordmark inverse />
      <p>
        {t.footer.brand}
      </p>
    </div>

    <div>
      <h2>{t.footer.visit}</h2>
      <ul>
        {visit.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li>
          <a href={other} lang={locale === "en" ? "sl" : "en"}>{t.footer.otherLang}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{t.footer.recent}</h2>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/journal/${post.id}`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.name}. {site.owner}.</p>
    <p>{t.footer.noTracking}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-forest);
    color: var(--color-ink-inverse);
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1.1fr;
    gap: var(--space-2xl);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    margin: 0 0 var(--space-m);
    color: rgb(246 245 242 / 0.55);
  }

  p,
  li,
  a {
    color: rgb(246 245 242 / 0.82);
    font-size: 0.95rem;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--color-ink-inverse);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .brand p {
    margin: var(--space-m) 0;
    max-width: 22rem;
  }

  .brand a {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-ink-inverse);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid rgb(246 245 242 / 0.12);
  }

  .legal p {
    margin: 0;
    font-size: var(--step-small);
    color: rgb(246 245 242 / 0.5);
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
