---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const siteKey = "0x4AAAAAAEfGY3WAkhzOXjc_";
---

<!-- Journal notes. Paper field, hairline, live type. No avatars. Approved only. Tokens from :root. -->
<section class="comments" data-slug={slug}>
  <form class="comments-form">
    <label class="hp">
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <label>
      Name
      <input type="text" name="name" autocomplete="name" required minlength="2" maxlength="80" />
    </label>
    <label>
      A note
      <textarea name="body" rows="5" required minlength="8" maxlength="1500"></textarea>
    </label>
    <button class="btn btn-primary" type="submit">Send</button>
    <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>
  </form>
  <p class="comments-thanks" hidden>Thanks. It will show once it’s been read.</p>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const host = document.querySelector("section.comments[data-slug]");
  if (host instanceof HTMLElement) {
    const slug = host.dataset.slug ?? "";
    const form = host.querySelector(".comments-form");
    const thanks = host.querySelector(".comments-thanks");

    const fmt = (iso) => {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
    };

    const renderList = (items) => {
      host.querySelector(".comments-list")?.remove();
      host.classList.remove("has-list");
      if (!items.length) return;
      const ol = document.createElement("ol");
      ol.className = "comments-list";
      for (const item of items) {
        const li = document.createElement("li");
        const head = document.createElement("div");
        head.className = "comments-head";
        const name = document.createElement("span");
        name.className = "comments-name";
        name.textContent = item.name;
        const time = document.createElement("time");
        time.dateTime = item.created_at;
        time.textContent = fmt(item.created_at);
        head.append(name, time);
        const body = document.createElement("p");
        body.className = "comments-body";
        body.textContent = item.body;
        li.append(head, body);
        ol.append(li);
      }
      if (form) host.insertBefore(ol, form);
      else host.prepend(ol);
      host.classList.add("has-list");
    };

    fetch("/api/comments?slug=" + encodeURIComponent(slug), { cache: "no-store" })
      .then((res) => (res.ok ? res.json() : []))
      .then((data) => {
        if (Array.isArray(data)) renderList(data);
      })
      .catch(() => {});

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || form.dataset.busy) return;
      form.dataset.busy = "1";
      const submit = form.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      const data = new FormData(form);
      const tokenEl = form.querySelector('[name="cf-turnstile-response"]');
      const token = tokenEl instanceof HTMLInputElement ? tokenEl.value : "";

      try {
        const res = await fetch("/api/comments", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            slug,
            name: String(data.get("name") ?? ""),
            body: String(data.get("body") ?? ""),
            website: String(data.get("website") ?? ""),
            "cf-turnstile-response": token,
          }),
        });

        if (res.status === 201 || res.status === 204) {
          form.hidden = true;
          if (thanks instanceof HTMLElement) thanks.hidden = false;
          return;
        }
      } catch {
        /* stay on the form */
      }

      form.dataset.busy = "";
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
      const w = window as unknown as { turnstile?: { reset: () => void } };
      w.turnstile?.reset();
    });
  }
</script>

<style>
  .comments {
    width: min(var(--measure), calc(100% - var(--gutter) * 2));
    margin-inline: auto;
    margin-block: var(--space-2xl) var(--space-3xl);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-xl);
  }

  .comments :global(.comments-list) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .comments :global(.comments-list li) {
    padding-block: var(--space-l);
  }

  .comments :global(.comments-list li + li) {
    border-top: 1px solid var(--color-line);
  }

  .comments :global(.comments-head) {
    display: flex;
    gap: var(--space-m);
    align-items: baseline;
  }

  .comments :global(.comments-name) {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--color-ink);
  }

  .comments :global(.comments-list time) {
    font-family: var(--font-body);
    font-size: var(--step-micro);
    color: var(--color-muted);
  }

  .comments :global(.comments-body) {
    margin: var(--space-xs) 0 0;
    font-family: var(--font-body);
    font-size: var(--step-body);
    line-height: var(--leading-body);
    color: var(--color-ink);
  }

  .comments-form {
    display: grid;
    gap: var(--space-m);
    margin-top: 0;
    background: transparent;
    border: 0;
    padding: 0;
  }

  .has-list .comments-form {
    margin-top: var(--space-xl);
  }

  .comments-form label {
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .comments-form input,
  .comments-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 0.75rem 0.85rem;
  }

  .comments-form textarea {
    resize: vertical;
  }

  .comments-form input:focus-visible,
  .comments-form textarea:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .comments-form .btn {
    justify-self: start;
  }

  @media (width <= 860px) {
    .comments-form .btn {
      width: auto;
      justify-self: start;
    }
  }

  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .comments-thanks {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--color-muted);
    margin: 0;
    animation: comments-in var(--duration) var(--ease);
  }

  .comments-thanks[hidden] {
    display: none;
  }

  @keyframes comments-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .comments-thanks {
      animation: none;
    }
  }
</style>
