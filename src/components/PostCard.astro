---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { copy, localeFromPath, type Locale } from "../lib/i18n";
import { isDesignedHero } from "../lib/journal";

interface Props {
  post: CollectionEntry<"journal">;
  locale?: Locale;
}

const { post } = Astro.props;
const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);
const date = post.data.pubDate.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const kicker = post.data.archive ? t.archiveKicker : post.data.tags[0];
const hero = post.data.hero;
const hasHero = Boolean(hero);
const isDesigned = isDesignedHero(post);
const isPortrait = Boolean(hero && !isDesigned && hero.height > hero.width);
---

<!-- Designed empty-archive still: one shared 4:3 drawing. Cover/center, bottom-only veil, live title overlay. Photos keep the existing veil. Do not duplicate this file per post. -->
<article class:list={["card", hasHero ? "card-photo" : "card-type"]}>
  <a href={`/journal/${post.id}`}>
    {
      hasHero && post.data.hero ? (
        <div class:list={["media", isPortrait && "is-portrait", isDesigned && "is-designed"]}>
          <Image
            src={post.data.hero}
            alt={post.data.heroAlt ?? ""}
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 30vw, 90vw"
            quality={70}
            format="webp"
          />
          <div class="veil">
            <p class="meta">
              {kicker && <span class="kicker">{kicker}</span>}
              <span class="author">{post.data.author}</span>
            </p>
            <h3>{post.data.title}</h3>
            <time datetime={post.data.pubDate.toISOString()}>{date}</time>
          </div>
        </div>
      ) : (
        <div class="type">
          <p class="meta">
            {kicker && <span class="kicker">{kicker}</span>}
            <span class="author">{post.data.author}</span>
          </p>
          <h3>{post.data.title}</h3>
          <time datetime={post.data.pubDate.toISOString()}>{date}</time>
        </div>
      )
    }
  </a>
</article>

<style>
  .card a {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .media,
  .type {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-ink);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s var(--ease);
  }

  .media.is-portrait :global(img) {
    object-position: top;
  }

  .media.is-designed {
    background: var(--designed-field);
  }

  .media.is-designed :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .media.is-designed h3 {
    color: var(--color-ink-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: var(--track-caps);
  }

  .veil,
  .type {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-l);
    color: var(--color-ink-inverse);
  }

  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 10 10 / 0.05) 20%, rgb(10 10 10 / 0.72) 100%);
  }

  .media.is-designed .veil {
    background: linear-gradient(180deg, #0000 45%, #0a0a0acc);
  }

  .type {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-height: 100%;
    border-top: 1px solid var(--color-accent);
  }

  .card-type {
    transition: transform var(--duration) var(--ease);
  }

  .card-type:hover {
    transform: translateY(-4px);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin: 0 0 0.5rem;
  }

  .kicker {
    color: var(--color-ink-inverse);
    opacity: 0.9;
  }

  .card-type .kicker {
    color: var(--color-accent);
    opacity: 1;
  }

  .author,
  time {
    font-size: var(--step-small);
    color: rgb(246 245 242 / 0.78);
  }

  h3 {
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    color: var(--color-ink-inverse);
    letter-spacing: 0.08em;
  }

  .card-photo:hover .media :global(img) {
    transform: scale(1.05);
  }

  .card-photo:hover .media.is-designed :global(img) {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-photo:hover .media :global(img) {
      transform: none;
    }

    .card-type,
    .type {
      transition: none;
    }

    .card-type:hover {
      transform: none;
    }
  }
</style>
