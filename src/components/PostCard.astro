---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"journal">;
}

const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const kicker = post.data.archive ? "From the archive" : post.data.tags[0];
---

<article class="card">
  <a href={`/journal/${post.id}`}>
    <div class="media">
      <Image
        src={post.data.hero}
        alt={post.data.heroAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 30vw, 90vw"
        quality={70}
        format="webp"
      />
      <div class="veil">
        <p class="meta">
          {kicker && <span class="kicker">{kicker}</span>}
          <span class="author">{post.data.author}</span>
        </p>
        <h3>{post.data.title}</h3>
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      </div>
    </div>
  </a>
</article>

<style>
  .card a {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-ink);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .veil {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-l);
    color: var(--color-ink-inverse);
    background: linear-gradient(180deg, rgb(10 10 10 / 0.05) 20%, rgb(10 10 10 / 0.72) 100%);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin: 0 0 0.5rem;
  }

  .kicker {
    color: var(--color-ink-inverse);
    opacity: 0.9;
  }

  .author,
  time {
    font-size: var(--step-small);
    color: rgb(246 245 242 / 0.78);
  }

  h3 {
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    color: var(--color-ink-inverse);
    letter-spacing: 0.08em;
  }

  .card:hover .media :global(img) {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .media :global(img) {
      transform: none;
    }
  }
</style>
