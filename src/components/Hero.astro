---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { copy, localeFromPath, type Locale } from "../lib/i18n";
import wordmarkImg from "../assets/from-wp/fitfambam-wordmark.webp";

interface Props {
  tagline: string;
  image: ImageMetadata;
  imageAlt: string;
  showHistoricMark?: boolean;
  locale?: Locale;
  scrollLabel?: string;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const {
  tagline,
  image,
  imageAlt,
  showHistoricMark = false,
  scrollLabel = copy(locale).scroll,
} = Astro.props;
---

<section class="hero" data-hero>
  <Image
    class="bg"
    src={image}
    alt={imageAlt}
    widths={[800, 1200, 1600, 1920]}
    sizes="100vw"
    quality={72}
    format="webp"
    loading="eager"
    fetchpriority="high"
  />
  <div class="scrim"></div>
  <div class="copy">
    {
      showHistoricMark ? (
        <Image
          class="historic"
          src={wordmarkImg}
          alt="Fit Fam Bam"
          widths={[640, 960, 1280]}
          sizes="(min-width: 800px) 42rem, 88vw"
          quality={70}
          format="webp"
          loading="eager"
        />
      ) : (
        <p class="word">Fit Fam Bam</p>
      )
    }
    <h1 class="sr-only">FitFamBam</h1>
    <p class="tag">{tagline}</p>
    <a class="cue" href="#about">{scrollLabel}</a>
  </div>
</section>

<script>
  const hero = document.querySelector("[data-hero]");
  const bg = hero?.querySelector(".bg");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (hero instanceof HTMLElement && bg instanceof HTMLElement && !reduce) {
    const onScroll = () => {
      const y = Math.min(window.scrollY, hero.offsetHeight);
      bg.style.transform = `translate3d(0, ${y * 0.22}px, 0) scale(1.08)`;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    color: var(--color-ink-inverse);
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    z-index: 0;
    transform: scale(1.08);
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(10 10 10 / 0.35) 0%, rgb(10 10 10 / 0.40) 45%, rgb(10 10 10 / 0.62) 100%);
  }

  .copy {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 4rem;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .historic {
    width: min(38rem, 86vw);
    height: auto;
    mix-blend-mode: screen;
    filter: contrast(1.15) brightness(1.05);
  }

  .word {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--step-display);
    letter-spacing: var(--track-wordmark);
    text-transform: uppercase;
    line-height: 1;
    color: var(--color-ink-inverse);
  }

  .tag {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-micro);
    font-weight: 400;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: rgb(246 245 242 / 0.88);
  }

  .cue {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-inverse);
    text-decoration: none;
    opacity: 0.7;
  }

  .cue:hover {
    opacity: 1;
    color: var(--color-ink-inverse);
  }

  @media (prefers-reduced-motion: reduce) {
    .bg {
      transform: none;
      inset: 0;
      height: 100%;
    }
  }
</style>
