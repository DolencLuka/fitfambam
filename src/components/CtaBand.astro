---
import { getImage } from "astro:assets";
import { copy, localeFromPath, type Locale } from "../lib/i18n";
import bandImg from "../assets/from-wp/beach-looking-out.webp";

interface Props {
  title?: string;
  accent?: string;
  text?: string;
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);

const {
  title = t.cta.title,
  accent = t.cta.accent,
  text = t.cta.text,
} = Astro.props;

const bg = await getImage({ src: bandImg, width: 1920, format: "webp", quality: 70 });
---

<section class="band" style={`--band-image: url('${bg.src}')`}>
  <div class="scrim"></div>
  <div class="wrap">
    <h2>{title} <span class="accent">{accent}</span></h2>
    <p>{text}</p>
    <a class="btn btn-ghost" href={locale === "sl" ? "/sl/contact" : "/contact"}>{t.cta.button}</a>
  </div>
</section>

<style>
  .band {
    position: relative;
    color: var(--color-ink-inverse);
    padding: var(--space-4xl) 0;
    text-align: center;
    background-color: var(--color-forest);
    background-image: var(--band-image);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    overflow: hidden;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: rgb(10 10 10 / 0.52);
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  h2 {
    font-size: var(--step-1);
    max-width: 18ch;
    margin: 0 auto 0.6em;
  }

  p {
    color: rgb(246 245 242 / 0.82);
    max-width: 32rem;
    margin: 0 auto var(--space-xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .band {
      background-attachment: scroll;
    }
  }
</style>
