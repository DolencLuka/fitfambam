---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../lib/site";
import { copy, localeFromPath, type Locale } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  cover?: boolean;
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = copy(locale);

const {
  title,
  description = t.description,
  ogImage = "/og.webp",
  article = false,
  cover = false,
} = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.owner} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={t.ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
  </head>
  <body class:list={[{ cover }]}>
    <a class="skip" href="#main">{t.skip}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
