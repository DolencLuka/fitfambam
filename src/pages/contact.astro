---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";
import writeImg from "../assets/from-wp/beach-pier.webp";
---

<Layout
  title="Contact"
  description="Write to FitFamBam. A real inbox. No fake form backend, no mailing list trap."
>
  <div class="wrap layout">
    <header>
      <p class="kicker">Contact</p>
      <h1>Say <span class="accent">hello.</span></h1>
      <p class="lede">
        There is no bot behind this page. Write {site.email} when you want to talk.
      </p>
    </header>

    <figure>
      <Image src={writeImg} alt="A pier stretching into the sea" widths={[640, 1000]} sizes="(min-width: 800px) 40vw, 90vw" quality={70} format="webp" />
    </figure>
  </div>

  <div class="wrap grid">
    <p class="write">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Write {site.email}</a>
    </p>

    <aside>
      <h2>Privacy</h2>
      <p>
        We do not run analytics pixels on this site. We do not sell addresses. If you write, we read it. We may be slow. There are four children.
      </p>
      <h2>Where</h2>
      <p>Slovenia. Replies in English, and soon in Slovenian.</p>
    </aside>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  h1 {
    font-size: var(--step-1);
    margin: 0.3em 0 0.5em;
  }

  figure {
    margin: 0;
    overflow: hidden;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: var(--space-4xl);
    align-items: start;
  }

  .write {
    margin: 0;
  }

  aside h2 {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem;
  }

  aside h2:not(:first-child) {
    margin-top: var(--space-xl);
  }

  aside p {
    color: var(--color-muted);
    margin: 0;
  }

  @media (max-width: 800px) {
    .layout,
    .grid {
      grid-template-columns: 1fr;
    }

    figure :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
