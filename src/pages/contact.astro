---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";
import writeImg from "../assets/from-wp/beach-pier.webp";
---

<Layout
  title="Contact"
  description="Write to FitFamBam. A real inbox. No fake form backend, no mailing list trap."
>
  <div class="wrap layout">
    <header>
      <p class="kicker">Contact</p>
      <h1>Say <span class="accent">hello.</span></h1>
      <p class="lede">
        There is no bot behind this page. The form opens your mail app. If that fails, write {site.email} yourself.
      </p>
    </header>

    <figure>
      <Image src={writeImg} alt="A pier stretching into the sea" widths={[640, 1000]} sizes="(min-width: 800px) 40vw, 90vw" quality={70} format="webp" />
    </figure>
  </div>

  <div class="wrap grid">
    <form class="form" action={`mailto:${site.email}`} method="get" enctype="text/plain">
      <p class="notice">
        This uses <strong>mailto</strong>. Nothing is stored on a server. A form backend can come later, without pretending now.
      </p>

      <label>
        Your name
        <input type="text" name="name" autocomplete="name" required />
      </label>

      <label>
        Your email
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label>
        Message
        <textarea name="body" rows="7" required placeholder="A note is enough."></textarea>
      </label>

      <input type="hidden" name="subject" value="Hello from FitFamBam.com" />

      <button class="btn btn-primary" type="submit">Open email to {site.email}</button>
    </form>

    <aside>
      <h2>Privacy</h2>
      <p>
        We do not run analytics pixels on this site. We do not sell addresses. If you write, we read it. We may be slow. There are four children.
      </p>
      <h2>Where</h2>
      <p>Slovenia. Replies in English, and soon in Slovenian.</p>
      <p class="alt">
        Prefer a blank compose window?
        <a href={`mailto:${site.email}`}>Email directly</a>.
      </p>
    </aside>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  h1 {
    font-size: var(--step-1);
    margin: 0.3em 0 0.5em;
  }

  figure {
    margin: 0;
    overflow: hidden;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: var(--space-4xl);
  }

  .form {
    display: grid;
    gap: var(--space-m);
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    padding: var(--space-xl);
  }

  .notice {
    margin: 0;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: var(--step-small);
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 0.75rem 0.85rem;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  aside h2 {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem;
  }

  aside h2:not(:first-child) {
    margin-top: var(--space-xl);
  }

  aside p {
    color: var(--color-muted);
    margin: 0;
  }

  .alt {
    margin-top: var(--space-l);
  }

  @media (max-width: 800px) {
    .layout,
    .grid {
      grid-template-columns: 1fr;
    }

    figure :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
