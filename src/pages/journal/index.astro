---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import CtaBand from "../../components/CtaBand.astro";
import { copy } from "../../lib/i18n";
import { splitJournal } from "../../lib/journal";

const t = copy("en");
const posts = (await getCollection("journal")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const { photographs, archive } = splitJournal(posts);
const archiveCards = archive.filter((post) => post.data.hero);
const archivePlain = archive.filter((post) => !post.data.hero);
---

<Layout
  title="Journal"
  description="A family journal from Slovenia. Mariah’s 2015 FitFamBam archive, and new notes from Luka when there is something worth keeping."
>
  <header class="page-hero wrap">
    <p class="kicker">Journal</p>
    <h1>A family <span class="accent">journal.</span></h1>
    <p class="lede">
      English. Mariah wrote here in 2015. Those pieces stay, attributed to her. Luka writes when he has something worth keeping. Not a programme. Not a scrape of other people’s advice.
    </p>
  </header>

  <section class="photographs" aria-labelledby="photographs-heading">
    <div class="wrap head">
      <h2 id="photographs-heading" class="kicker">{t.photographs}</h2>
    </div>
    <div class="wrap-wide cards">
      {photographs.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="writing" aria-labelledby="archive-heading">
    <div class="wrap head">
      <h2 id="archive-heading" class="kicker">{t.archiveKicker}</h2>
    </div>
    {
      archiveCards.length > 0 && (
        <div class="wrap-wide cards">
          {archiveCards.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
    {
      archivePlain.length > 0 && (
        <div class="wrap">
          <ArchiveList posts={archivePlain} />
        </div>
      )
    }
  </section>

  <CtaBand />
</Layout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  h1 {
    font-size: var(--step-1);
    max-width: 14ch;
    margin: 0.3em 0 0.5em;
  }

  .head {
    margin-bottom: var(--space-l);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .writing {
    padding: var(--space-3xl) 0;
  }

  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
