---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import PostCard from "../../components/PostCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { copy } from "../../lib/i18n";
import { featuredJournal } from "../../lib/featured";
import heroImg from "../../assets/from-wp/countryside-meadow.webp";
import whyImg from "../../assets/from-wp/couple.webp";

const t = copy("sl");
const posts = await featuredJournal(3);
---

<Layout
  title="FitFamBam"
  description={t.description}
  locale="sl"
  cover
>
  <Hero
    tagline={t.tagline}
    image={heroImg}
    imageAlt="Travnik in gozd na slovenskem podeželju"
    locale="sl"
  />

  <section class="about" id="about">
    <div class="wrap split">
      <div class="copy">
        <p class="kicker">O nas</p>
        <h2>Družinska stran. <span class="accent">Ne telovadnica.</span></h2>
        <p class="lede">
          Luka in Mariah, štirje otroci, Slovenija. Zjutraj po poroki leta 2011 je prišla iz Kalifornije. Dnevnik je njun: Mariahini zapisi iz leta 2015 in novi Luka.
        </p>
        <p>
          FitFamBam je njun prostor za življenje, ki prestane polno hišo. Ni članarin, ni paketov, ni izmišljenih prej-in-potem.
        </p>
        <p>
          Mariah je tu pisala prva, leta 2015. Tisti zapisi ostanejo, z njenim imenom. Luka stran spet postavlja zato, da imata oba prostor — stran, ki izgleda kot fotografija in se bere kot pismo.
        </p>
        <p>
          Če iščeš franšizo, izziv ali koga, ki vpije z odra, bo to tiho. Tako je mišljeno.
        </p>
        <p class="rhythm">Gibanje · Hrana · Počitek · Skupaj</p>
        <a class="btn" href="/sl/about">Kaj to je in kaj ni</a>
      </div>
      <figure>
        <Image src={whyImg} alt="Luka in Mariah" widths={[640, 960, 1400]} sizes="(min-width: 800px) 45vw, 90vw" quality={72} format="webp" />
      </figure>
    </div>
  </section>

  <Section tone="soft" eyebrow="Od Luke" title="Kratek zapis.">
    <blockquote class="note">
      <p>
        Sem Luka Dolenc. Živim v Sloveniji z Mariah in našimi štirimi otroki. Bolj mi je mar, da sem jim v korist, kot da zgledam natreniran.
      </p>
      <p>
        Mariah je prvi FitFamBam dnevnik pisala leta 2015. Ne bom se pretvarjal, da so tisti stavki moji. Pisal bom, ko bo kaj vredno obdržati. Množice za aplavz si ne bom izmislil.
      </p>
      <footer>— Luka</footer>
    </blockquote>
  </Section>

  <section class="photos" id="photos">
    <div class="wrap head">
      <p class="kicker">Fotografije</p>
      <h2>Iz arhiva.</h2>
    </div>
    <PhotoGrid locale="sl" />
  </section>

  <Section eyebrow="Dnevnik" title="Zadnje pisanje.">
    <div class="posts">
      {posts.map((post) => <PostCard post={post} locale="sl" />)}
    </div>
    <p class="more"><a href="/sl/journal">Vsi zapisi</a></p>
  </Section>

  <CtaBand locale="sl" />
</Layout>

<style>
  .about {
    padding: var(--space-4xl) 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .copy p + p {
    margin-top: 1em;
  }

  .copy h2 {
    font-size: var(--step-1);
    margin: 0.4em 0 0.6em;
  }

  .rhythm {
    margin: 1.5em 0 !important;
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .note {
    margin: 0;
    max-width: 40rem;
    font-size: var(--step-3);
    line-height: 1.6;
  }

  .note footer {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    font-size: var(--step-micro);
    color: var(--color-accent-dark);
  }

  .photos {
    padding: var(--space-3xl) 0 0;
  }

  .photos .head {
    margin-bottom: var(--space-xl);
  }

  .photos h2 {
    font-size: var(--step-1);
    margin: 0.35em 0 0;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .more {
    margin-top: var(--space-xl);
  }

  .more a {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .split,
    .posts {
      grid-template-columns: 1fr;
    }

    figure :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
