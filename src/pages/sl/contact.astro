---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../lib/site";
import writeImg from "../../assets/from-wp/beach-pier.webp";
---

<Layout
  title="Kontakt"
  description="Piši FitFamBam. Pravi predal. Ni lažnega obrazca, ni pasti za e-pošto."
  locale="sl"
>
  <div class="wrap layout">
    <header>
      <p class="kicker">Kontakt</p>
      <h1>Reci <span class="accent">živjo.</span></h1>
      <p class="lede">
        Za to stranjo ni bota. Piši na {site.email}, kadar želiš spregovoriti.
      </p>
    </header>

    <figure>
      <Image src={writeImg} alt="Pomol v morje" widths={[640, 1000]} sizes="(min-width: 800px) 40vw, 90vw" quality={70} format="webp" />
    </figure>
  </div>

  <div class="wrap grid">
    <p class="write">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Piši na {site.email}</a>
    </p>

    <aside>
      <h2>Zasebnost</h2>
      <p>
        Ne poganjamo sledilnih pikslov. Naslovov ne prodajamo. Če napišeš, preberemo. Lahko smo počasni. Imamo štiri otroke.
      </p>
      <h2>Kje</h2>
      <p>Slovenija. Odgovarjava v slovenščini in angleščini.</p>
    </aside>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  h1 {
    font-size: var(--step-1);
    margin: 0.3em 0 0.5em;
  }

  figure {
    margin: 0;
    overflow: hidden;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: var(--space-4xl);
    align-items: start;
  }

  .write {
    margin: 0;
  }

  aside h2 {
    font-family: var(--font-display);
    font-size: var(--step-micro);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem;
  }

  aside h2:not(:first-child) {
    margin-top: var(--space-xl);
  }

  aside p {
    color: var(--color-muted);
    margin: 0;
  }

  @media (max-width: 800px) {
    .layout,
    .grid {
      grid-template-columns: 1fr;
    }

    figure :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
