---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostCard from "../../../components/PostCard.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { copy } from "../../../lib/i18n";
import { splitJournal } from "../../../lib/journal";

const t = copy("sl");
const posts = (await getCollection("journal")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const { photographs, archive } = splitJournal(posts);
---

<Layout
  title="Dnevnik"
  description={t.description}
  locale="sl"
>
  <header class="page-hero wrap">
    <p class="kicker">Dnevnik</p>
    <h1>Družinski <span class="accent">dnevnik.</span></h1>
    <p class="lede">
      Zapisi so v angleščini. Mariah je tu pisala leta 2015. Tisti kosi ostanejo, z njenim imenom. Luka piše, ko ima kaj vrednega obdržati. Ni program. Ni poberka tujih nasvetov.
    </p>
  </header>

  <section class="photographs" aria-labelledby="photographs-heading">
    <div class="wrap head">
      <h2 id="photographs-heading" class="kicker">{t.photographs}</h2>
    </div>
    <div class="wrap-wide cards">
      {photographs.map((post) => <PostCard post={post} locale="sl" />)}
    </div>
  </section>

  <section class="writing" aria-labelledby="archive-heading">
    <div class="wrap head">
      <h2 id="archive-heading" class="kicker">{t.archiveKicker}</h2>
    </div>
    <div class="wrap">
      <ArchiveList posts={archive} locale="sl" />
    </div>
  </section>

  <CtaBand locale="sl" />
</Layout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  h1 {
    font-size: var(--step-1);
    max-width: 14ch;
    margin: 0.3em 0 0.5em;
  }

  .head {
    margin-bottom: var(--space-l);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }

  .writing {
    padding: var(--space-3xl) 0;
  }

  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
